# SvelteKit Public Environment Variables
# These are exposed to the browser via $env/static/public
# Replace with your actual Price IDs from Stripe Dashboard for local development.
PUBLIC_STRIPE_PRICE_ID_MONTHLY="price_yourmonthlypriceid_from_stripe_dashboard"
PUBLIC_STRIPE_PRICE_ID_YEARLY="price_youryearlypriceid_from_stripe_dashboard"

# Example for configuring the backend URL for SvelteKit if needed
# VITE_BACKEND_URL="http://localhost:8000"
