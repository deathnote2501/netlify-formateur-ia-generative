DATABASE_URL="postgresql://user:password@host:port/dbname"
SECRET_KEY="your_super_secret_key_here_for_jwt_and_fastapi_users"

# Stripe Configuration (Backend - Secret Keys, Webhook Secret)
STRIPE_SECRET_KEY="sk_test_yourtestsecretkey"
STRIPE_WEBHOOK_SECRET="whsec_yourwebhooksigningsecret"
# The following price IDs are for backend reference if needed, e.g. via settings.STRIPE_PRICE_ID_MONTHLY
# They are NOT directly used by SvelteKit's $env/static/public
STRIPE_PRICE_ID_MONTHLY="price_yourmonthlypriceid_for_backend"
STRIPE_PRICE_ID_YEARLY="price_youryearlypriceid_for_backend"
FRONTEND_DOMAIN="http://localhost:5173"

# --- SvelteKit Public Environment Variables ---
# These are exposed to the browser via $env/static/public
# Prefix with PUBLIC_

# Stripe Public Price IDs (Replace with your actual Price IDs from Stripe Dashboard)
PUBLIC_STRIPE_PRICE_ID_MONTHLY="price_replace_with_your_monthly_price_id"
PUBLIC_STRIPE_PRICE_ID_YEARLY="price_replace_with_your_yearly_price_id"

# Example for configuring the backend URL if not same-origin and no proxy for SvelteKit
# VITE_BACKEND_URL="http://localhost:8000"
